# Keep secrets server-side. Never prefix credentials with NEXT_PUBLIC_.
APP_BASE_URL=https://crm.arclivolabs.com
MONGODB_URI=mongodb://127.0.0.1:27017/arclivolabs-crm
REDIS_URL=redis://127.0.0.1:6379
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
# Generate a random secret with at least 32 characters.
AUTH_SECRET=replace-with-at-least-32-random-characters

# Meta WhatsApp Cloud API (server-side only; never use NEXT_PUBLIC_ prefixes)
META_WHATSAPP_ACCESS_TOKEN=replace-with-a-server-side-meta-access-token
META_WHATSAPP_PHONE_NUMBER_ID=replace-with-the-meta-phone-number-id
META_WHATSAPP_BUSINESS_ACCOUNT_ID=replace-with-the-whatsapp-business-account-id
META_APP_SECRET=replace-with-the-meta-app-secret
META_WEBHOOK_VERIFY_TOKEN=replace-with-a-long-random-webhook-verify-token
META_GRAPH_API_VERSION=replace-with-a-current-supported-version
# Generate a base64-encoded 32-byte key; keep it private and stable while credentials are stored.
META_CREDENTIALS_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
